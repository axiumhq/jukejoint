      ],
      "port": 4190
    },
    {
      "name": "v7",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4191",
        "--directory",
        "prototipos/v7"
      ],
      "port": 4191
    }
  ]
}